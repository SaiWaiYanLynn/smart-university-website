erDiagram
  USER ||--o| STUDENT_RECORD : has
  USER ||--o{ CONVERSATION : owns
  USER ||--o{ RESERVATION : makes
  USER ||--o{ REQUEST : submits
  USER ||--o{ AUDIT_LOG : generates
  CONVERSATION ||--o{ MESSAGE : contains
  RESOURCE ||--o{ SLOT : offers
  SLOT ||--o| RESERVATION : filled_by
  REQUEST ||--o{ REQUEST_EVENT : has_history
  USER ||--o{ REQUEST_EVENT : changes
  DOCUMENT ||--o{ DOCUMENT_CHUNK : split_into
  BOOK ||--o{ LOAN : lent_as
  USER ||--o{ LOAN : borrows
  USER ||--o{ CHARGE : owes
  CHARGE ||--o{ PAYMENT_CHECK : paid_by
  USER ||--o{ PAYMENT_CHECK : submits
  USER ||--o{ PAYMENT_CHECK : decides
  PAYMENT_CHECK ||--|| SLIP_FILE : shows
  USER ||--o{ MEMORY_FACT : remembered_for
  CONVERSATION ||--o{ MEMORY_FACT : source_of
  RESERVATION ||--o| ADVISOR_BRIEF : prepared_for
  UNANSWERED_QUESTION }o--o| DOCUMENT : closed_by
  COURSE ||--o{ ENROLLMENT : has
  USER ||--o{ ENROLLMENT : takes
  COURSE ||--o{ CLASS_SESSION : meets_as
  CLASS_SESSION ||--o{ ATTENDANCE : records
  USER ||--o{ ATTENDANCE : attends
  USER ||--o{ ADVISOR_LINK : advises
  USER ||--o{ ADVISOR_LINK : advised_by
  USER ||--o{ NOTIFICATION : receives
  MESSAGE ||--o| FEEDBACK : rated_by
  USER ||--o{ WATCH : asks_for
  REQUEST ||--o{ WATCH : watched_by
  USER ||--o{ PENDING_QUESTION : waits_for
  DOCUMENT ||--o{ SOURCE_CONFLICT : disagrees_in

  USER {
    uuid id PK
    string keycloak_sub UK
    string full_name
    string role
    string email
  }
  STUDENT_RECORD {
    uuid id PK
    uuid user_id FK
    string student_number UK
    string programme
    int year_of_study
    string registration_status
    decimal outstanding_balance
  }
  RESOURCE {
    uuid id PK
    string name
    string resource_type
    int capacity
    string location
    int cancel_cutoff_minutes
  }
  SLOT {
    uuid id PK
    uuid resource_id FK
    timestamp starts_at
    timestamp ends_at
    boolean is_open
  }
  RESERVATION {
    uuid id PK
    uuid slot_id FK
    uuid user_id FK
    string state
    timestamp created_at
  }
  REQUEST {
    uuid id PK
    uuid user_id FK
    string reference UK
    string request_type
    string state
    jsonb payload
    timestamp created_at
  }
  REQUEST_EVENT {
    uuid id PK
    uuid request_id FK
    string from_state
    string to_state
    uuid changed_by FK
    timestamp changed_at
  }
  CONVERSATION {
    uuid id PK
    uuid user_id FK
    string channel
    string external_id
    boolean human_owned
  }
  MESSAGE {
    uuid id PK
    uuid conversation_id FK
    string author
    text body
    string routed_to_agent
    timestamp created_at
  }
  DOCUMENT {
    uuid id PK
    string title
    string section
    string source_url
    string language
    string state
  }
  DOCUMENT_CHUNK {
    uuid id PK
    uuid document_id FK
    text content
    vector embedding
  }
  AUDIT_LOG {
    uuid id PK
    uuid actor_id FK
    string action
    string target
    string outcome
    timestamp occurred_at
  }
  BOOK {
    uuid id PK
    string title
    string author
    string isbn UK
    string call_number
    string shelf_location
    int copies_total
    int copies_available
  }
  LOAN {
    uuid id PK
    uuid book_id FK
    uuid user_id FK
    date due_on
    int renewals
  }
  CHARGE {
    uuid id PK
    uuid user_id FK
    string description
    decimal amount
    date due_on
    string state
  }
  PAYMENT_CHECK {
    uuid id PK
    uuid charge_id FK
    uuid submitted_by FK
    uuid decided_by FK
    string state
    decimal amount_on_slip
    string reason
    timestamp submitted_at
    timestamp decided_at
  }
  SLIP_FILE {
    uuid id PK
    uuid payment_check_id FK
    string storage_path
    string mime_type
    timestamp keep_until
  }
  MEMORY_FACT {
    uuid id PK
    uuid user_id FK
    uuid conversation_id FK
    string topic
    text content
    timestamp saved_at
  }
  ADVISOR_BRIEF {
    uuid id PK
    uuid reservation_id FK
    text content
    timestamp updated_at
  }
  UNANSWERED_QUESTION {
    uuid id PK
    uuid document_id FK
    text question
    int times_asked
    string state
    timestamp last_asked_at
  }

  COURSE {
    uuid id PK
    string code UK
    string title
    int credits
    uuid instructor_id FK
    string room
    string schedule
  }
  ENROLLMENT {
    uuid id PK
    uuid course_id FK
    uuid user_id FK
    string term
    string grade
    boolean counts_in_average
  }
  CLASS_SESSION {
    uuid id PK
    uuid course_id FK
    timestamp starts_at
    string kind
  }
  ATTENDANCE {
    uuid id PK
    uuid session_id FK
    uuid user_id FK
    string status
    int minutes_late
  }
  ADVISOR_LINK {
    uuid id PK
    uuid advisor_id FK
    uuid advisee_id FK
  }
  NOTIFICATION {
    uuid id PK
    uuid user_id FK
    string title
    text body
    boolean is_read
    timestamp created_at
  }
  FEEDBACK {
    uuid id PK
    uuid message_id FK
    boolean helpful
    timestamp created_at
  }
  WATCH {
    uuid id PK
    uuid user_id FK
    uuid request_id FK
    string channel
    boolean active
  }
  PENDING_QUESTION {
    uuid id PK
    uuid user_id FK
    uuid conversation_id FK
    text question
    int retries
    timestamp next_try_at
  }
  SOURCE_CONFLICT {
    uuid id PK
    uuid document_a FK
    uuid document_b FK
    text passage_a
    text passage_b
    string state
  }
  APPLICATION {
    uuid id PK
    string reference UK
    string applicant_name
    string email
    string programme
    string intake
    string state
  }
  CONTACT_MESSAGE {
    uuid id PK
    string name
    string email
    string topic
    text body
    timestamp created_at
  }
  CONTENT_ITEM {
    uuid id PK
    string kind
    string title
    text body
    date published_on
  }
